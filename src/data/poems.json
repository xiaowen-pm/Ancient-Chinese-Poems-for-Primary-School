  {
    "id": "jiangnan",
    "title": "江南",
    "author": "汉乐府",
    "dynasty": "汉",
    "titlePinyin": "jiāng nán",
    "authorPinyin": "hàn yuè fǔ",
    "dynastyPinyin": "hàn",
    "tag": "一年级上 · 必背第 01 首",
    "pageColor": "#dcebe6",
    "effect": "ripple",
    "image": "images/jiangnan.webp",
    "lines": [
      {
        "text": "江南可采莲，",
        "pinyin": "jiāng nán kě cǎi lián ，",
        "key": "采莲",
        "gloss": "江南又到了**采莲**的好时节。",
        "note": "**江南**：长江以南的地方。**可**：适宜、正好。**采莲**：采摘莲蓬。"
      },
      {
        "text": "莲叶何田田。",
        "pinyin": "lián yè hé tián tián 。",
        "key": "田田",
        "gloss": "莲叶又大又圆，**密密地**挤在一起。",
        "note": "**何**：多么。**田田**：莲叶又圆又绿、一片连着一片、长得茂盛的样子。"
      },
      {
        "text": "鱼戏莲叶间。",
        "pinyin": "yú xì lián yè jiān 。",
        "key": "鱼戏",
        "gloss": "小鱼在莲叶中间**游来游去**做游戏。",
        "note": "**戏**：嬉戏，游来游去地玩耍。**间**：中间。"
      },
      {
        "text": "鱼戏莲叶东，",
        "pinyin": "yú xì lián yè dōng ，",
        "key": "东",
        "gloss": "一会儿游到莲叶的**东边**，",
        "note": "**东**：东边。这一句和下面三句是「反复」，一句接一句地唱。"
      },
      {
        "text": "鱼戏莲叶西，",
        "pinyin": "yú xì lián yè xī ，",
        "key": "西",
        "gloss": "一会儿又游到**西边**，",
        "note": "**西**：西边。"
      },
      {
        "text": "鱼戏莲叶南，",
        "pinyin": "yú xì lián yè nán ，",
        "key": "南",
        "gloss": "一会儿游到**南边**，",
        "note": "**南**：南边。"
      },
      {
        "text": "鱼戏莲叶北。",
        "pinyin": "yú xì lián yè běi 。",
        "key": "北",
        "gloss": "一会儿又游到**北边**，真快活！",
        "note": "**北**：北边。东、西、南、北四个方向一起写，好像到处都是快活的小鱼。"
      }
    ],
    "hotspots": [
      { "x": 22, "y": 30, "label": "田田莲叶", "line": 1 },
      { "x": 62, "y": 66, "label": "嬉戏锦鲤", "line": 2 },
      { "x": 80, "y": 18, "label": "采莲小舟", "line": 0 }
    ],
    "story": "我们是江南采莲的姑娘。夏天划着小船进荷塘，荷叶比伞还大，鱼儿就在叶子底下钻来钻去，东边一下、西边一下，我们一边采莲一边唱歌。",
    "sceneQuiz": {
      "question": "小鱼在哪里做游戏？",
      "options": ["莲叶间", "石头下", "天空中"],
      "answer": 0
    },
    "translation": "江南又到了适合采莲的季节，莲叶浮出水面，挨挨挤挤，一片连着一片，多么茂盛啊！欢快的小鱼在莲叶中间游来游去。一会儿游到莲叶东边，一会儿游到西边，一会儿游到南边，一会儿又游到北边。",
    "appreciation": [
      "🌿 **只写叶，不写花**：诗里只夸莲叶「田田」，可叶子这么美，荷花一定更美，留给我们去想象。",
      "🐟 **用鱼写人**：没有一个字说采莲人开心，可小鱼游得这么快活，采莲人划着小船穿来穿去，心情也一样快活。",
      "🧭 **东西南北·反复**：「鱼戏莲叶」连说五次，只换了方向，读起来像唱儿歌，一唱一和，越读越有趣。"
    ],
    "background": "这是一首**汉代乐府民歌**，作者已经不知道是谁了。汉代有个叫「乐府」的官署，专门收集老百姓唱的歌。江南水多、湖多，夏秋时荷叶飘香、莲蓬结子，青年男女就划着小船去**采莲**，一边采一边唱歌——这首就是采莲时唱的歌。它属于「相和歌」：可能是一人领唱、大家跟着和，后面东西南北四句就是大家一起和唱的部分。",
    "quizzes": [
