[
  {
    "id": "jingye",
    "title": "静夜思",
    "author": "李白",
    "dynasty": "唐",
    "titlePinyin": "jìng yè sī",
    "authorPinyin": "lǐ bái",
    "dynastyPinyin": "táng",
    "tag": "一年级下 · 必背第 08 首",
    "pageColor": "#dfe3ea",
    "effect": "glow",
    "image": "images/jingye.webp",
    "lines": [
      {
        "text": "床前明月光，",
        "pinyin": "chuáng qián míng yuè guāng ，",
        "key": "明月光",
        "gloss": "月光洒在床前的地上，亮亮的、白白的。"
      },
      {
        "text": "疑是地上霜。",
        "pinyin": "yí shì dì shàng shuāng 。",
        "key": "霜",
        "gloss": "诗人以为是地上结了一层**霜**，这是把月光比作霜。"
      },
      {
        "text": "举头望明月，",
        "pinyin": "jǔ tóu wàng míng yuè ，",
        "key": "举头",
        "gloss": "他抬起头，看见天上又大又圆的**明月**。"
      },
      {
        "text": "低头思故乡。",
        "pinyin": "dī tóu sī gù xiāng 。",
        "key": "故乡",
        "gloss": "低下头，忽然很想念远方的**家乡**。"
      }
    ],
    "hotspots": [
      { "x": 22, "y": 18, "label": "皎洁明月", "line": 0 },
      { "x": 62, "y": 82, "label": "满地银霜", "line": 1 },
      { "x": 70, "y": 42, "label": "望月诗人", "line": 2 }
    ],
    "story": "我是李白。那年我二十六岁，一个人离家很远很远。秋天的晚上睡不着，月光照进屋里，白得像霜。我抬头看月亮，想起家乡的月亮也是这样圆……",
    "sceneQuiz": {
      "question": "画面里地上白白亮亮的，诗人以为是什么？",
      "options": ["霜", "雪", "水"],
      "answer": 0
    }
  },
  {
    "id": "chunxiao",
    "title": "春晓",
    "author": "孟浩然",
    "dynasty": "唐",
    "titlePinyin": "chūn xiǎo",
    "authorPinyin": "mèng hào rán",
    "dynastyPinyin": "táng",
    "tag": "一年级下 · 必背第 05 首",
    "pageColor": "#e3ead9",
    "effect": "petal",
    "image": "images/chunxiao.webp",
    "lines": [
      {
        "text": "春眠不觉晓，",
        "pinyin": "chūn mián bù jué xiǎo ，",
        "key": "不觉晓",
        "gloss": "春天睡得真香，**不知不觉**天就亮了。"
      },
      {
        "text": "处处闻啼鸟。",
        "pinyin": "chù chù wén tí niǎo 。",
        "key": "啼鸟",
        "gloss": "到处都能听到小鸟叽叽喳喳地**叫**。"
      },
      {
        "text": "夜来风雨声，",
        "pinyin": "yè lái fēng yǔ shēng ，",
        "key": "风雨声",
        "gloss": "想起昨天夜里，有呼呼的风声和沙沙的雨声。"
      },
      {
        "text": "花落知多少。",
        "pinyin": "huā luò zhī duō shǎo 。",
        "key": "知多少",
        "gloss": "不知道又有**多少花瓣**被吹落了呢？"
      }
    ],
    "hotspots": [
      { "x": 48, "y": 34, "label": "枝头啼鸟", "line": 1 },
      { "x": 58, "y": 84, "label": "满阶落花", "line": 3 },
      { "x": 14, "y": 55, "label": "推窗晨起", "line": 0 }
    ],
    "story": "我是孟浩然，住在山里。那天早上我睡了个大懒觉，一睁眼窗外全是鸟叫声。我想起昨夜下了一场春雨，赶紧推开门——台阶上落满了花瓣。",
    "sceneQuiz": {
      "question": "画面里枝头唱歌的是什么？",
      "options": ["啼鸟", "蝴蝶", "蜜蜂"],
      "answer": 0
    }
  },
  {
    "id": "shanxing",
    "title": "山行",
    "author": "杜牧",
    "dynasty": "唐",
    "titlePinyin": "shān xíng",
    "authorPinyin": "dù mù",
    "dynastyPinyin": "táng",
    "tag": "三年级上 · 必背第 21 首",
    "pageColor": "#efe0d6",
    "effect": "leaf",
    "image": "images/shanxing.webp",
    "lines": [
      {
        "text": "远上寒山石径斜，",
        "pinyin": "yuǎn shàng hán shān shí jìng xié ，",
        "key": "石径斜",
        "gloss": "一条弯弯曲曲的**石头小路**，一直通到秋天的山上。"
      },
      {
        "text": "白云生处有人家。",
        "pinyin": "bái yún shēng chù yǒu rén jiā 。",
        "key": "白云生处",
        "gloss": "在**白云飘起的地方**，住着几户人家。"
      },
      {
        "text": "停车坐爱枫林晚，",
        "pinyin": "tíng chē zuò ài fēng lín wǎn ，",
        "key": "坐爱",
        "gloss": "我停下马车，是因为**喜爱**傍晚的枫树林。"
      },
      {
        "text": "霜叶红于二月花。",
        "pinyin": "shuāng yè hóng yú èr yuè huā 。",
        "key": "霜叶",
        "gloss": "经霜的枫叶，比二月的春花还要**红**。"
      }
    ],
    "hotspots": [
      { "x": 50, "y": 62, "label": "蜿蜒石径", "line": 0 },
      { "x": 46, "y": 30, "label": "云中人家", "line": 1 },
      { "x": 78, "y": 40, "label": "霜叶红枫", "line": 3 }
    ],
    "story": "我是杜牧。那天我坐着马车上山，路弯弯的。太阳快落山了，满山枫叶红得像火。我忍不住喊车夫：「停一停！」就坐在那儿看了好久好久。",
