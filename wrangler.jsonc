{
  "name": "ancient-chinese-poems-for-primary-school",
  "compatibility_date": "2026-10-26",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Replace example.com with a Resend-verified sender before mail will send.
  // The API key is a secret, not a var: `npx wrangler secret put RESEND_API_KEY`.
  "vars": {
    "RESEND_FROM": "必背诗笺 <pdf@example.com>"
  },
  // SIGNUPS is intentionally not bound yet. A KV entry without an id makes
  // Workers Builds try to create the namespace, and that token cannot.
  // After the namespace exists, add the same block at the top level and under previews:
  // "kv_namespaces": [{ "binding": "SIGNUPS", "id": "<namespace id from the dashboard>" }]
  // The Worker reads env.SIGNUPS. Until that id is filled in, the page still
  // returns the PDF link and does not persist the address on Cloudflare.
  // Required by `npx wrangler preview` on non-production branches.
  // Previews do not inherit vars, so the sender is repeated here.
  // Assets and the Worker name stay at the top level and are shared.
  "previews": {
    "vars": {
      "RESEND_FROM": "必背诗笺 <pdf@example.com>"
    }
  }
}
